# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ==============================================================================
# SUPABASE / VERCEL INTEGRATION VARIABLES
# (These are typically auto-populated by the Supabase Vercel integration)
# ==============================================================================
POSTGRES_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
POSTGRES_PRISMA_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
POSTGRES_URL_NON_POOLING="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
POSTGRES_USER="postgres"
POSTGRES_HOST="[HOST]"
POSTGRES_PASSWORD="[PASSWORD]"
POSTGRES_DATABASE="postgres"

SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# NOTE: Since this is a Vite project (not Next.js), you MUST use VITE_ 
# instead of NEXT_PUBLIC_ for variables accessed in the browser (React).
# We map them here for convenience:
VITE_SUPABASE_URL=$SUPABASE_URL
VITE_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY

# The Next.js variables can remain here safely if Vercel injects them automatically:
NEXT_PUBLIC_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=$SUPABASE_URL

# Backend API hosted on Render.
# Frontend should point to the deployed scraper/database service.
VITE_BACKEND_API_URL="https://diplom-data-api.onrender.com"

# Firebase frontend config.
# These values are public identifiers for the web app, not service account secrets.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_GA_MEASUREMENT_ID"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
